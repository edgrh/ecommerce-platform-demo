<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bcommerce.mapper.ProductSkuMapper">

    <select id="selectMinPriceBySpuIds" resultType="com.bcommerce.web.dto.SpuMinPriceRow">
        SELECT spu_id AS spuId, MIN(price_cent) AS priceCent
        FROM bc_product_sku
        WHERE spu_id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        GROUP BY spu_id
    </select>
</mapper>
